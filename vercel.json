{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "sh scripts/vercel-build.sh",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/Collide", "destination": "/", "permanent": true },
    { "source": "/Collide/:path*", "destination": "/:path*", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!assets/|icons/)[^.]*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/registerSW.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/assets/index-(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
