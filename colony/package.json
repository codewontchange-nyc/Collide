{
  "name": "colony",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Colony: everyone has a role, each one is vital.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
